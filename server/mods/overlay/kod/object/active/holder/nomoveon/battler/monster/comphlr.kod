% Custom: companion healer: heals the group, some damage, light robes.

CompanionHealer is Companion

constants:

   include blakston.khd
   include protocol.khd

resources:

   comphlr_name_rsc = "healer companion"
   comphlr_dead_name_rsc = "dead healer companion"

classvars:

   vrDead_name = comphlr_dead_name_rsc
   viRole = COMPANION_ROLE_HEALER
   viDefault_behavior = AI_FIGHT_MONSTERS | AI_MOVE_FOLLOW_MASTER | AI_MOVE_OPTIMAL_RANGE
   viColorTranslate1 = XLAT_TO_SKY
   viColorTranslate2 = XLAT_TO_GRAY

properties:

messages:

   SetEquipment()
   {
      send(self,@AddEquipmentObject,#what=create(&Mace));
      send(self,@SetTroopArmor,#NewArmor=create(&DiscipleRobe));

      return;
   }

   GetOptimalRange()
   {
      return 4;
   }

   CompanionAct()
   {
      local oWorst, iWorst, i, iPct, iSid, lMembers, oSpell;

      % heal whoever of the group in this room is hurt the most (below 70 percent)
      oWorst = $;
      iWorst = 70;
      if poGroup <> $
      {
         lMembers = Send(poGroup,@GetMembers);
         for i in lMembers
         {
            if Send(i,@GetOwner) = poOwner
            {
               iPct = Send(i,@GetHealthPercent);
               if iPct < iWorst
               {
                  iWorst = iPct;
                  oWorst = i;
               }
            }
         }
      }

      if oWorst <> $ AND Send(self,@InRange,#oTarget=oWorst,#iSquares=9)
      {
         if piEcl >= 26 AND iWorst < 45
         {
            iSid = SID_MAJOR_HEAL;
         }
         else
         {
            iSid = SID_MINOR_HEAL;
         }

         if Send(self,@CastAt,#num=iSid,#oTarget=oWorst)
         {
            return;
         }
      }

      % nobody needs healing: keep the group blessed (one buff per think)
      if poGroup <> $
      {
         for iSid in [SID_BLESS,SID_MAGIC_SHIELD,SID_ARMOR_OF_GORT,SID_RESIST_MAGIC]
         {
            oSpell = Send(SYS,@FindSpellByNum,#num=iSid);
            for i in Send(poGroup,@GetMembers)
            {
               if oSpell <> $ AND i <> self AND Send(i,@GetOwner) = poOwner
                  AND Send(self,@InRange,#oTarget=i,#iSquares=9)
                  AND Send(self,@NeedsBuff,#oTarget=i,#oSpell=oSpell)
               {
                  if Send(self,@CastAt,#num=iSid,#oTarget=i)
                  {
                     return;
                  }
               }
            }
         }
      }

      % otherwise a little damage
      if poTarget <> $ AND Send(self,@InRange,#oTarget=poTarget,#iSquares=8)
      {
         if piEcl <= 25
         {
            iSid = SID_SHOCKING_FURY;
         }
         else
         {
            iSid = SID_SMITE;
            if piEcl < 40 { iSid = SID_BLAST_OF_FIRE; }
         }

         Send(self,@CastAt,#num=iSid,#oTarget=poTarget);
      }

      return;
   }

end
