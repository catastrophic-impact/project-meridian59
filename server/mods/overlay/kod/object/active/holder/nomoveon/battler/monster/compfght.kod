% Custom: companion fighter: shoots a bow from a distance (no archery skill needed) and fights in melee when the enemy gets close.

CompanionFighter is Companion

constants:

   include blakston.khd
   include protocol.khd

resources:

   compfght_name_rsc = "fighter companion"
   compfght_dead_name_rsc = "dead fighter companion"

classvars:

   vrDead_name = compfght_dead_name_rsc
   viRole = COMPANION_ROLE_FIGHTER
   viColorTranslate1 = XLAT_TO_DGREEN
   viColorTranslate2 = XLAT_TO_ORANGE

properties:

   % the arrow chosen for the current target (the fighter has endless arrows of every kind)
   piArrowType = 0
   piArrowSpell = 0
   piArrowBonus = 0

messages:

   ChooseArrow(what = $)
   "Picks the arrow kind the target is weakest against (nerudite, fire, silver, plain): that is the best arrow for the situation."
   {
      local iBest, iResist, i, lArrows;

      % [attack type, spell type, extra damage, class]
      lArrows = [ [ATCK_WEAP_PIERCE + ATCK_WEAP_NERUDITE, 0, 1, &NeruditeArrow],
                  [ATCK_WEAP_PIERCE, ATCK_SPELL_FIRE, 1, &FireArrow],
                  [ATCK_WEAP_PIERCE + ATCK_WEAP_SILVER, 0, 0, &SilverArrow],
                  [ATCK_WEAP_PIERCE, 0, 0, &Arrow] ];
      piArrowType = ATCK_WEAP_PIERCE;
      piArrowSpell = 0;
      piArrowBonus = 0;
      iBest = 1000;
      if what = $ OR NOT IsClass(what,&Battler)
      {
         return &Arrow;
      }

      for i in lArrows
      {
         iResist = Send(what,@ResistanceCheck,#atype=First(i),#aspell=Nth(i,2));
         iResist = iResist - Nth(i,3);
         if iResist < iBest
         {
            iBest = iResist;
            piArrowType = First(i);
            piArrowSpell = Nth(i,2);
            piArrowBonus = Nth(i,3);
         }
      }

      piMinDamage = 1 + (piEcl / 20) + piArrowBonus;
      piMaxDamage = 5 + (piEcl / 10) + piArrowBonus;

      for i in lArrows
      {
         if First(i) = piArrowType AND Nth(i,2) = piArrowSpell
         {
            return Nth(i,4);
         }
      }

      return &Arrow;
   }

   GetDamageType(what = $)
   {
      if piArrowType <> 0
      {
         return piArrowType;
      }

      propagate;
   }

   GetSpellType(what = $)
   {
      if piArrowType <> 0
      {
         return piArrowSpell;
      }

      propagate;
   }

   AdjustStats()
   {
      % A fighter is as good as a player who was just handed a bow: a plain arrow does 1 to 5 and it has no archery
      % skill. It only gets better as its master's ECL grows (a little extra damage per level).
      piOffense = 120 + (piEcl * 10);
      piDefense = 100 + (piEcl * 8);
      piMinDamage = 1 + (piEcl / 20);
      piMaxDamage = 5 + (piEcl / 10);

      return;
   }

   SetEquipment()
   {
      send(self,@AddEquipmentObject,#what=create(&Bow));
      send(self,@SetTroopArmor,#NewArmor=create(&LeatherArmor));

      return;
   }

   GetAttackTime()
   "A player can shoot about once a second, so does the fighter."
   {
      return 1000 + Random(0,200);
   }

   IsRanged()
   {
      return TRUE;
   }

   GetAttackRange()
   "The bow reaches nine squares (line of sight); closer than that the fighter keeps shooting until the enemy is in its face, then it is simply a melee fight."
   {
      return 9;
   }

   MonsterAttack(what = $)
   "Called right before the attack roll: at a distance, show an arrow flying."
   {
      local oArrow;

      piArrowType = 0;
      piMinDamage = 1 + (piEcl / 20);
      piMaxDamage = 5 + (piEcl / 10);
      if what <> $ AND poOwner <> $ AND Send(self,@SquaredDistanceTo,#what=what) > 9
      {
         oArrow = Create(Send(self,@ChooseArrow,#what=what));
         Send(poOwner,@SomethingShot,#who=self,#target=what,#projectile=oArrow);
         Send(oArrow,@Delete);
      }

      propagate;
   }

end
